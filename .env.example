# Environment Variables for Production & Local Deployment

# Database Configuration (Cloud SQL / PostgreSQL / Supabase / Neon / Railway)
# Option 1: Full Connection String
DATABASE_URL=

# Option 2: Individual Connection Parameters
SQL_HOST=
SQL_USER=
SQL_PASSWORD=
SQL_DB_NAME=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=

# Security & Authentication
JWT_SECRET=

# CORS Configuration (Allowed origin domain or '*' for all)
CORS_ORIGIN=*

# Frontend API URL (leave empty for same-origin proxy, or set e.g. https://your-backend-api.com)
VITE_API_URL=

# GEMINI_API_KEY: Required for Gemini AI API features.
GEMINI_API_KEY=

# APP_URL: The public URL where this applet is hosted.
APP_URL=
